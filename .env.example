# Copy to .env for development. Never commit real secrets.
NODE_ENV=development
APP_ENV=dev
APP_PORT=3050
PUBLIC_BASE_URL=http://localhost:3050
NEXT_PUBLIC_BASE_URL=http://localhost:3050
# Keep false until every production content, legal, provider and operations gate passes.
NEXT_PUBLIC_RELEASE_READY=false
API_INTERNAL_URL=http://api:4000
TZ=UTC
DISPLAY_TIME_ZONE=Asia/Tehran
# Must match the deployment account that owns var/. Containers remain non-root.
APP_UID=1000
APP_GID=1000

# Reviewed image digests are Compose defaults. Override only through an approved release.
POSTGRES_IMAGE=postgres@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
REDIS_IMAGE=redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf
CLAMAV_IMAGE=clamav/clamav@sha256:b25d9199257ae7ef45e0cc4c7eaa60ce7e5447796f0090d5ff311d1a30980cc3

POSTGRES_DB=novin
POSTGRES_USER=novin
POSTGRES_PASSWORD=change-me-dev-only
# Used by API/worker containers. Host scripts resolve the Compose IP in dev/test.
DATABASE_URL=postgresql://novin:change-me-dev-only@postgres:5432/novin
REDIS_URL=redis://redis:6379/0

SESSION_SECRET=change-me-to-at-least-32-random-bytes
SESSION_TTL_SECONDS=28800
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_CALLBACK_SECRET=
TAX_RATE_BPS=0
OFFER_DEFAULT_VALIDITY_DAYS=7

CAPTCHA_PROVIDER=bypass
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg

DEV_SMS_INBOX_ENABLED=true
DEV_EMAIL_INBOX_ENABLED=true
SEED_SYNTHETIC_DATA=true

BACKUP_AGE_RECIPIENT=
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
TRUSTED_PROXY_COUNT=1

# Production must reject: mock/bypass providers, dev inboxes, default secrets,
# synthetic seed, missing legal/provider/company gates, and an HTTP base URL.
