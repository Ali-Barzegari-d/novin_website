server {
    listen 80;
    listen [::]:80;
    server_name karafintech.ir www.karafintech.ir;
    return 301 https://karafintech.ir$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name karafintech.ir;

    # Configure certificate paths using the host's approved certificate flow.
    ssl_certificate     /etc/letsencrypt/live/karafintech.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karafintech.ir/privkey.pem;

    client_max_body_size 12m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Enable only after the certificate and canonical HTTPS path are verified.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:3050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.karafintech.ir;
    ssl_certificate     /etc/letsencrypt/live/karafintech.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karafintech.ir/privkey.pem;
    return 301 https://karafintech.ir$request_uri;
}
